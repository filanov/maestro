# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache git make protobuf protobuf-dev

# Install protoc plugins
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@latest && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest && \
    go install github.com/grpc-ecosystem/grpc-gateway/v2/protoc-gen-openapiv2@latest

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Generate proto files and build
RUN mkdir -p api/openapi && \
    protoc --go_out=. --go_opt=paths=source_relative \
    --go-grpc_out=. --go-grpc_opt=paths=source_relative \
    --openapiv2_out=api/openapi \
    --openapiv2_opt=logtostderr=true,allow_merge=true,merge_file_name=agent \
    api/proto/agent/v1/*.proto && \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /bin/agent ./cmd/agent

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates bash

WORKDIR /app

# Copy binary
COPY --from=builder /bin/agent .

# Run as non-root
RUN adduser -D -u 1000 maestro && \
    chown -R maestro:maestro /app
USER maestro

ENTRYPOINT ["/app/agent"]
